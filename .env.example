# Copy outside the checkout, e.g. ~/.config/safe-git-mcp/project-a.env.
# Host paths must be absolute. Use single quotes for spaces or literal $. Do not use ~.
PROJECT_ROOT=/absolute/path/to/approved-standalone-test-repository
POLICY_FILE=/absolute/operator-managed/path/to/project-a.toml

# Replace with the repository owner's values from: id -u; id -g
# Use a non-root account. Do not chown original repositories or bypass ownership checks.
HOST_UID=1000
HOST_GID=1000

# Optional: local image tag and independent Compose project namespace.
SAFE_GIT_IMAGE=safe-git-mcp:local
COMPOSE_PROJECT_NAME=safe-git-project-a

# This file is for Compose interpolation, not service env_file injection.
# Keep access-control rules in the separately mounted TOML policy (/repo binding).
# Never put credentials here. Shell-exported variables take precedence over this file.
